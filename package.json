{
  "name": "forge-freight",
  "private": true,
  "version": "0.1.0",
  "description": "FORGE Freight \u2014 digital freight forwarding operating system for African trade corridors",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:integration": "pnpm --filter @forge-freight/api test:integration",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "dev:infra": "docker compose up -d",
    "db:migrate": "pnpm --filter @forge-freight/db migrate",
    "db:seed": "pnpm --filter @forge-freight/db seed"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "typescript-eslint": "^8.63.0"
  }
}

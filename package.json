{
  "name": "forge-freight",
  "private": true,
  "version": "0.1.0",
  "description": "FORGE Freight \u2014 digital freight forwarding operating system for African trade corridors",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:integration": "pnpm --filter @forge-freight/api test:integration",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "dev:infra": "docker compose up -d",
    "db:migrate": "pnpm --filter @forge-freight/db migrate",
    "db:seed": "pnpm --filter @forge-freight/db seed"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "typescript-eslint": "^8.63.0"
  },
  "pnpm": {
    "overrides": {
      "multer@<2.2.0": ">=2.2.0",
      "sharp@<0.35.0": ">=0.35.0",
      "nanoid@<3.3.16": ">=3.3.16",
      "postcss@<8.5.23": ">=8.5.23",
      "fast-uri@<3.1.4": ">=3.1.4",
      "brace-expansion@<5.0.8": ">=5.0.8"
    }
  }
}

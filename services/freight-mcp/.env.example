# Copy to .env for local runs. .env is gitignored — never commit real values.

# Freight Core, reachable from wherever this process runs.
FREIGHT_API_URL=http://localhost:3000

# Service credential presented to the API. Must match INGEST_API_KEY there.
#   openssl rand -hex 32
FREIGHT_MCP_API_KEY=

# Optional.
FREIGHT_MCP_TIMEOUT_MS=30000
FREIGHT_MCP_AGENT_ID=hermes

# There is deliberately no DATABASE_URL. This server is an HTTP client against
# the Freight Core API and has no code that would use one.

# Copy to .env for local runs. .env is gitignored — never commit real values.

# Freight Core, reachable from wherever this process runs.
FREIGHT_API_URL=http://localhost:3000

# Presented as x-agent-key. Must equal AGENT_API_KEY on the API — see
# apps/api/src/modules/auth/jwt.guard.ts. Empty on the API side means this
# server cannot authenticate at all; the API refuses the request, not this one.
#   openssl rand -hex 32
FREIGHT_MCP_AGENT_KEY=

# The one tenant this instance may read — "one instance per tenant," the same
# shape infrastructure/n8n already uses. Must be a real tenant uuid.
FREIGHT_MCP_TENANT_ID=

# Optional.
FREIGHT_MCP_TIMEOUT_MS=30000
FREIGHT_MCP_AGENT_ID=hermes

# stdio (default) for a locally-spawned agent process; http for a remote
# agent host — this is what runs on ECS. See src/main.ts.
MCP_TRANSPORT=stdio
MCP_HTTP_PORT=9000

# There is deliberately no DATABASE_URL. This server is an HTTP client against
# the Freight Core API and has no code that would use one.

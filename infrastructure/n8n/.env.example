# Copy to .env and fill in. .env is gitignored — never commit real values.
#
#   cp .env.example .env

# --- n8n's own database (workflows and run history; no freight data) --------
N8N_DB_PASSWORD=change-me-locally

# --- n8n UI login -----------------------------------------------------------
N8N_ADMIN_USER=admin@forgefreight.local
N8N_ADMIN_PASSWORD=change-me-locally

# Encrypts saved credentials at rest. Generate once per environment and keep
# it stable — changing it orphans every stored credential.
#   openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# --- Talking to the Freight Core -------------------------------------------
# Reachable from *inside* the n8n container.
#   local docker:  http://host.docker.internal:3000
#   staging/prod:  the internal service URL, never the public one
FREIGHT_API_URL=http://host.docker.internal:3000

# Machine key. Must equal INGEST_API_KEY in the API's environment.
#   openssl rand -hex 32
FREIGHT_INGEST_API_KEY=

# Which forwarder this n8n instance works for. One instance per tenant: the
# mailbox it watches belongs to exactly one company, and putting the tenant in
# configuration rather than in the message means a malformed email cannot
# quote on someone else's book.
FREIGHT_TENANT_ID=

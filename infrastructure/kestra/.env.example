# Copy to .env and fill in. .env is gitignored — never commit real values.
#
#   cp .env.example .env

# --- Kestra's own database (execution history; no freight data) -------------
KESTRA_DB_PASSWORD=change-me-locally

# --- Kestra UI login --------------------------------------------------------
KESTRA_ADMIN_USER=admin@forgefreight.local
KESTRA_ADMIN_PASSWORD=change-me-locally

# --- Talking to the Freight Core -------------------------------------------
# Where the API is reachable *from inside the Kestra container*.
#   local docker:  http://host.docker.internal:3000
#   staging/prod:  the internal service URL, never the public one
FREIGHT_API_URL=http://host.docker.internal:3000

# Machine-to-machine key. Must equal INGEST_API_KEY in the API's environment —
# the same key the tracking adapters use. Generate with:
#   openssl rand -hex 32
FREIGHT_INGEST_API_KEY=

{
  "name": "@forge-freight/ontology-bridge",
  "version": "0.1.0",
  "description": "Maps FORGE Freight canonical events to Revenue Ontology ledger events. The boundary artifact between freight operations and the ForgePay financial layer.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@forge-freight/events": "workspace:*",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}

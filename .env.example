# FORGE Freight API configuration. Validated at boot (apps/api/src/config.ts);
# the process refuses to start on invalid production config.

NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://forge:forge@localhost:5432/forge_freight
CORS_ORIGINS=http://localhost:3000

# Auth. jwt = verify Keycloak-issued bearer tokens; dev = trust x-dev-* headers
# (refused in production).
AUTH_MODE=jwt
AUTH_ISSUER=http://localhost:8080/realms/forge-freight
# AUTH_JWKS_URL defaults to <issuer>/protocol/openid-connect/certs
# AUTH_AUDIENCE=forge-freight-api
AUTH_TENANT_CLAIM=tenant_id

# Event bus. Empty KAFKA_BROKERS disables the outbox relay (events queue in
# Postgres until a relay ships them). Required in production.
KAFKA_BROKERS=localhost:19092
KAFKA_TOPIC_EVENTS=freight.events
OUTBOX_POLL_MS=500
OUTBOX_BATCH_SIZE=100

# Temporal (shipment lifecycle timers). Empty = disabled in dev; required in
# production. The worker (apps/worker) needs the same address.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# Machine-to-machine key for /ingest/* tracking webhooks (DCSA, Traccar,
# EDIFACT). Required in production.
INGEST_API_KEY=

# Sanctions screening (yente/OpenSanctions). Empty = skipped in dev with a
# warning; required in production. Screening failures fail CLOSED (review).
YENTE_URL=http://localhost:8000

# Document extraction. Empty = uploads go straight to manual review.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
EXTRACTION_REVIEW_THRESHOLD=0.85
DOC_STORAGE_DIR=./storage/documents

# Portal (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:3001
# Dev-only: tenant header the portal sends when the API runs AUTH_MODE=dev
NEXT_PUBLIC_DEV_TENANT_ID=

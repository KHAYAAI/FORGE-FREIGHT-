    "@nestjs/platform-express": "^10.4.15",
    "drizzle-orm": "^0.38.3",
    "jose": "^6.2.3",
    "kafkajs": "^2.2.4",
    "pdfkit": "^0.19.1",
    "reflect-metadata": "^0.2.2",

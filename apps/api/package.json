{
  "name": "@forge-freight/api",
  "version": "0.1.0",
  "description": "FORGE Freight modular monolith \u2014 NestJS backend.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@aws-sdk/client-s3": "^3.1116.0",
    "yaml": "^2.6.1",
    "@forge-freight/db": "workspace:*",
    "@forge-freight/events": "workspace:*",
    "@forge-freight/ontology-bridge": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/throttler": "^6.5.0",
    "@temporalio/client": "^1.22.0",
    "drizzle-orm": "^0.45.2",
    "helmet": "^8.3.0",
    "jose": "^6.2.10",
    "kafkajs": "^2.2.4",
    "multer": "^2.2.0",
    "pdfkit": "^0.19.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ws": "^8.21.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.1",
    "@types/pdfkit": "^0.17.6",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  }
}
